#!/bin/sh

# Record an X window with ffmpeg

# Globals
frame_rate=25
pixel_border=2
out_dir="$HOME/Videos/Record"
out_file="$out_dir/$(date +'%d-%m-%y-%ss').mp4"
pid_file="$HOME/.record.pid"
capture_audio_cmd_arg=''

die () {
   printf '%s: %s\n' "$0" "$*" >&2
   exit 1
}

requires () {
   for cmd in "$@" ; do
      command -v "$cmd" || die "$cmd: command not found"
   done >/dev/null
}

set_audio_capture_cmd () {
   if test -n "$(pgrep '^pipewire')" && command -v pactl >/dev/null ; then
      source=$(pactl list short sources | fgrep alsa_output | awk -F'[\t ]*' '{print $2}')
      test -n "$source" && capture_audio_cmd_arg="-f pulse -i ${source} -framerate $frame_rate"
   fi
}

record () {
   set_audio_capture_cmd

   ff_opts=$(
      xwininfo | awk -v pixel_border="$pixel_border" '
         /Height:/ { h = substr($0, 11) }
         /Width:/  { w = substr($0, 10) }
         /^[\t ]*A.* X:/ { x = substr($0, 27) }
         /^[\t ]*A.* Y:/ { y = substr($0, 27) }
         END {
            if (pixel_border) {
               x -= pixel_border
               y -= pixel_border
               w += (2 * pixel_border)
               h += (2 * pixel_border)
            }
            print "-video_size " w "x" h " -i :0.0+" x "," y
         }
      '
   )

   expr match "$ff_opts" '-video_size [0-9]\+x[0-9]\+ -i :0\.0+[0-9]\+,[0-9]\+' >/dev/null || die "Couldn't select the window."

   ffmpeg -hide_banner           \
          $capture_audio_cmd_arg  \
          -f x11grab               \
          $ff_opts                  \
          -framerate $frame_rate     \
          -pix_fmt rgba               \
          -qp 0                        \
          -preset ultrafast             \
          -y "$out_file" &

   printf $! >"$pid_file"
   waitpid $!
}

main () {
   requires xwininfo ffmpeg herbe

   if test -s "$pid_file" && pid=$(cat "$pid_file") && test -d "/proc/$pid" ; then
      kill -TERM "$pid"
   else
      mkdir -p "$out_dir"
      record
   fi
}

main "$@"
