#!/bin/sh

die () {
   printf '%s: %s\n.' "$0" "$1" >&2
   exit 1
}

{
   command -v fzf     || die 'fzf not found'
   command -v perldoc || die 'perldoc not found'
} >/dev/null


if ! test $# -ge 1 ; then
   die "Usage: $0 <module_name> [search_module]"
elif test $# -eq 1 ; then
   mod=$1
   search=$1
else
   mod=$1
   search=''
   shift
   for i in "$@" ; do
      search="$search${search:+|}$i"
   done
fi

doc=$(perldoc "$mod")
test $? -ne 0 && die "$doc"

res=$(printf '%s\n' "$doc" | perl -nE 'say $1 while /\G.*?((?:'"$search"')(?:::\w++)+)/g' | sort -u | fzf)

test -n "$res" && perldoc "$res"
