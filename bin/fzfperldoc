#!/bin/sh

die () {
   printf '%s: %s\n.' "$0" "$1" >&2
   exit 1
}

{
   command -v fzf     || die 'fzf not found'
   command -v perldoc || die 'perldoc not found'
} >/dev/null


if ! test $# -ge 1 ; then
   die "Usage: $0 <module_name> [search_module]"
elif test $# -eq 1 ; then
   data=$1
   base_mod=$1
else
   data=$1
   base_mod=''
   shift
   for mod in "$@" ; do
      base_mod="$base_mod${base_mod:+|}$mod"
   done
fi

doc=$(perldoc "$data")
test $? -ne 0 && die "$doc"

sub_mod=$(printf '%s\n' "$doc" | perl -nE 'say $1 while /\G.*?((?:'"$base_mod"')(?:::\w++)+)/g' | sort | uniq | fzf)

test -n "$sub_mod" && perldoc "$sub_mod"


